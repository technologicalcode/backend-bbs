# Base de datos (URL completa). En producción usa la URL del proveedor (Render, Railway, etc.).
# Local con Docker: npm run db:up y esta URL por defecto:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/bbs

# TypeORM: sincronizar esquema con las entidades (crear/alterar tablas). En producción poner false y usar migraciones.
TYPEORM_SYNC=false

# JWT access (Bearer) — segundos (900 = 15 min)
JWT_SECRET=cambia-esto-en-produccion
JWT_ACCESS_EXPIRES_SEC=900

# JWT refresh (cookie httpOnly) — secreto distinto al access; duración en segundos (604800 = 7 días)
JWT_REFRESH_SECRET=cambia-esto-refresh-en-produccion
JWT_REFRESH_EXPIRES_SEC=604800

# Cookie del refresh (opcional)
# JWT_REFRESH_COOKIE_NAME=refresh_token
# JWT_REFRESH_COOKIE_MAX_MS=604800000

# CORS (origen del frontend Angular, etc.)
# CORS_ORIGIN=http://localhost:4200

# Semilla de datos (npm run seed). En producción requiere SEED_FORCE=true
# SEED_CLEAR=false   # no vaciar tablas antes (npm run seed:keep)
# SEED_FORCE=true    # permitir semilla en NODE_ENV=production
